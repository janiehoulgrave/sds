rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Compass banner library -- readable/writable by any signed-in Compass user.
    match /banners/{bannerId} {
      allow read: if request.auth != null
                   && request.auth.token.email.matches('.*@compass[.]com');
      allow write: if request.auth != null
                    && request.auth.token.email.matches('.*@compass[.]com');
    }

    // Per-user private data -- only the owner can read or write their own tree.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /signatures/{sigId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /media/{mediaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared, admin-published data (e.g. published templates).
    // ANY signed-in Compass user may READ it (so everyone gets the published
    // templates), but ONLY the single admin account may WRITE it. This is the
    // real enforcement behind the "Publish to all users" button -- even a user
    // who bypasses the front-end admin gate cannot write here.
    match /shared/{docId} {
      allow read: if request.auth != null
                   && request.auth.token.email.matches('.*@compass[.]com');
      allow write: if request.auth != null
                    && request.auth.uid == '1idnAdK800UUzg7xW9hmH76OgH82';
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
