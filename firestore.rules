rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── TEMPORARY ROLLOUT ALLOWLIST ──────────────────────────────────────
    // While rolling out, only these emails may read/write anything. Keep this
    // list identical to ALLOWED_EMAILS in the app code (SignatureStudio.jsx).
    // To approve someone: add their lowercase email here AND in the code, then
    // republish these rules and redeploy the code.
    // To open access to ALL @compass.com users later: make isAllowed() return
    // isCompass() (and set ALLOWLIST_ENABLED = false in the code).
    function isCompass() {
      return request.auth != null
             && request.auth.token.email.matches('.*@compass[.]com');
    }
    function isAllowed() {
      return request.auth != null && request.auth.token.email in [
        'janie.houlgrave@compass.com',
        'amy.peery@compass.com',
        'laura.carr@compass.com',
        'a.vang@compass.com',
        'sarah.menard@compass.com',
        'kimberly.winters@compass.com',
        'lindsey.mcnerney@compass.com',
        'toria.hester@compass.com'
      ];
    }

    // Compass banner library -- approved users only during rollout.
    match /banners/{bannerId} {
      allow read: if isAllowed();
      allow write: if isAllowed();
    }

    // Per-user private data -- must be the owner AND on the allowlist.
    match /users/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
      match /signatures/{sigId} {
        allow read, write: if isAllowed() && request.auth.uid == uid;
      }
      match /media/{mediaId} {
        allow read, write: if isAllowed() && request.auth.uid == uid;
      }
    }

    // Shared, admin-published data (e.g. published templates).
    // Approved users may READ; only the admin account may WRITE.
    match /shared/{docId} {
      allow read: if isAllowed();
      allow write: if request.auth != null
                    && request.auth.uid == '1idnAdK800UUzg7xW9hmH76OgH82';
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
